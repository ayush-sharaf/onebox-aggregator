{
    "version": 2,
  "builds": [
    {
      "src": "backend/src/server.ts",
      "use": "@vercel/node",
      "config": { 
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "backend/config/**",
          "backend/models/**",
          "backend/services/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/src/server.ts"
    }
  ]
}